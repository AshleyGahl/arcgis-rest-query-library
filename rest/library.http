# Service Request Query Library — ArcGIS REST requests
# Generated by `npm run build:http`. Start the server first: `npm start`.
# Point @layer at a real FeatureServer layer to run the same requests there.

@layer = http://127.0.0.1:3000/arcgis/rest/services/ServiceRequests/FeatureServer/0

### Q1 — Total number of service requests  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&returnCountOnly=true

### Q2 — Count by Category  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC

### Q3 — Count by RequestType  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=RequestType
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC

### Q4 — Count by Status  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Status
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC

### Q5 — Count by Channel (how requests reach the council)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Channel
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC

### Q6 — Count by Suburb (excluding NULL)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20IS%20NOT%20NULL
&groupByFieldsForStatistics=Suburb
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Suburb

### Q7 — Count by Category and Status (cross-tab)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Category%2CStatus
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Category%2C%20Status

### Q8 — Count by Channel and Category  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Channel%2CCategory
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Channel%2C%20Category

### Q9 — Count of distinct request types overall  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&outFields=RequestType
&returnDistinctValues=true
&returnCountOnly=true
&returnGeometry=false

### Q10 — Count of requests with no Suburb (map pin only)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20IS%20NULL
&returnCountOnly=true

### Q11 — Requests by logged date (day)  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=CAST(DateLogged%20AS%20DATE)%20AS%20LogDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=LogDate

### Q12 — Requests by logged month and year  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=EXTRACT(YEAR%20FROM%20DateLogged)%20AS%20LogYear%2C%20EXTRACT(MONTH%20FROM%20DateLogged)%20AS%20LogMonth
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=LogYear%2C%20LogMonth

### Q13 — Requests by weekday  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=DATEPART(weekday%2C%20DateLogged)%20AS%20WeekDay
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=WeekDay
&sqlFormat=native

### Q14 — Requests by hour of day  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=EXTRACT(HOUR%20FROM%20DateLogged)%20AS%20LogHour
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=LogHour

### Q15 — Requests completed by date  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&groupByFieldsForStatistics=CAST(DateCompleted%20AS%20DATE)%20AS%20CompleteDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=CompleteDate

### Q16 — Monthly trend of requests (year-month and count)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=FORMAT(DateLogged%2C%20'yyyy-MM')%20AS%20YearMonth
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=YearMonth
&sqlFormat=native

### Q17 — Weekly trend (ISO week, ISO year)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=DATEPART(iso_week%2C%20DateLogged)%20AS%20ISOWeek%2C%20YEAR(DATEADD(day%2C%2026%20-%20DATEPART(iso_week%2C%20DateLogged)%2C%20DateLogged))%20AS%20ISOYear
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=ISOYear%2C%20ISOWeek
&sqlFormat=native

### Q18 — Count requests logged in the last 7 days  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateLogged%20%3E%3D%20CURRENT_TIMESTAMP%20-%20INTERVAL%20'7'%20DAY
&returnCountOnly=true

### Q19 — Count requests logged in the current month  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=EXTRACT(YEAR%20FROM%20DateLogged)%20%3D%20EXTRACT(YEAR%20FROM%20CURRENT_DATE)%20AND%20EXTRACT(MONTH%20FROM%20DateLogged)%20%3D%20EXTRACT(MONTH%20FROM%20CURRENT_DATE)
&returnCountOnly=true

### Q20 — Count requests logged per day of week (with day names)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&sqlFormat=native
&groupByFieldsForStatistics=DATENAME(weekday%2C%20DateLogged)%20AS%20WeekDayName
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%2C%7B%22statisticType%22%3A%22min%22%2C%22onStatisticField%22%3A%22DATEPART(weekday%2C%20DateLogged)%22%2C%22outStatisticFieldName%22%3A%22WeekDayNo%22%7D%5D
&orderByFields=WeekDayNo

### Q21 — Average resolution time (days) overall  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgDaysToComplete%22%7D%5D

### Q22 — Average resolution time by Category  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgDays%22%7D%5D
&orderByFields=AvgDays

### Q23 — Average resolution time by Channel  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&groupByFieldsForStatistics=Channel
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgDays%22%7D%5D
&orderByFields=AvgDays

### Q24 — Minimum and maximum resolution time overall  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&outStatistics=%5B%7B%22statisticType%22%3A%22min%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22MinDays%22%7D%2C%7B%22statisticType%22%3A%22max%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22MaxDays%22%7D%5D

### Q25 — Ten slowest request types (average days to close, min 10 closed)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Status%20%3D%20'Closed'%20AND%20DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&groupByFieldsForStatistics=RequestType
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgDays%22%7D%2C%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Closed%22%7D%5D
&having=COUNT(ObjectID)%20%3E%3D%2010
&orderByFields=AvgDays%20DESC
&resultRecordCount=10

### Q26 — Median resolution time (using PERCENTILE_CONT)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&outStatistics=%5B%7B%22statisticType%22%3A%22percentile_cont%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22MedianDays%22%2C%22statisticParameters%22%3A%7B%22value%22%3A0.5%7D%7D%5D

### Q27 — Count of requests that took more than 7 days to complete  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL%20AND%20DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%20%3E%207
&sqlFormat=native
&returnCountOnly=true

### Q28 — Average age (days) of open requests by Category  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Status%20%3C%3E%20'Closed'
&sqlFormat=native
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20GETDATE())%22%2C%22outStatisticFieldName%22%3A%22AvgAgeDays%22%7D%2C%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22OpenCount%22%7D%5D
&orderByFields=AvgAgeDays%20DESC

### Q29 — Mean vs median resolution days by Category (skew check)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22MeanDays%22%7D%2C%7B%22statisticType%22%3A%22percentile_cont%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22MedianDays%22%2C%22statisticParameters%22%3A%7B%22value%22%3A0.5%7D%7D%5D
&orderByFields=Category

### Q30 — Requests completed on the same day they were logged  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL%20AND%20CAST(DateLogged%20AS%20DATE)%20%3D%20CAST(DateCompleted%20AS%20DATE)
&returnCountOnly=true

### Q31 — All requests with Status = 'In Progress'  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Status%20%3D%20'In%20Progress'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q32 — Water Supply requests reported through the App  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Channel%20%3D%20'App'%20AND%20Category%20%3D%20'Water%20Supply'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q33 — Open requests in Khayelitsha  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20%3D%20'Khayelitsha'%20AND%20Status%20%3C%3E%20'Closed'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q34 — Requests completed in the last 30 days  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL%20AND%20DateCompleted%20%3E%3D%20CURRENT_TIMESTAMP%20-%20INTERVAL%20'30'%20DAY
&outFields=*
&orderByFields=ObjectID%20DESC

### Q35 — Requests with Category containing 'Water'  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Category%20LIKE%20'%25Water%25'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q36 — Phone requests that are Closed  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Channel%20%3D%20'Phone'%20AND%20Status%20%3D%20'Closed'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q37 — All distinct request types reported in Sea Point  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20%3D%20'Sea%20Point'
&outFields=RequestType
&returnDistinctValues=true
&returnGeometry=false
&orderByFields=RequestType

### Q38 — Count per RequestType within 'Rubbish & Recycling'  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Category%20%3D%20'Rubbish%20%26%20Recycling'
&groupByFieldsForStatistics=RequestType
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC

### Q39 — Requests where Description contains 'leak' (case-insensitive)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=UPPER(Description)%20LIKE%20'%25LEAK%25'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q40 — Open requests with no Suburb (need location review)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20IS%20NULL%20AND%20Status%20%3C%3E%20'Closed'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q41 — Top 5 categories with most requests  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC
&resultRecordCount=5

### Q42 — Top 5 suburbs with most requests (excluding NULL)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20IS%20NOT%20NULL
&groupByFieldsForStatistics=Suburb
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC
&resultRecordCount=5

### Q43 — Running total of requests per day (cumulative)  [sql-expression]
# client-side transform: runningTotal
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=CAST(DateLogged%20AS%20DATE)%20AS%20LogDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22DailyCount%22%7D%5D
&orderByFields=LogDate

### Q44 — Month-over-month percentage change in request volume  [sql-expression]
# client-side transform: lag
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=EXTRACT(YEAR%20FROM%20DateLogged)%20AS%20Yr%2C%20EXTRACT(MONTH%20FROM%20DateLogged)%20AS%20Mo
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Cnt%22%7D%5D
&orderByFields=Yr%2C%20Mo

### Q45 — Rank categories by average completion time (fastest first)  [native]
# client-side transform: rank
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgDays%22%7D%5D
&orderByFields=AvgDays

### Q46 — For each Channel, count of distinct categories reported  [standard]
# client-side transform: groupCount
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Channel%2CCategory
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Channel%2C%20Category

### Q47 — Likely duplicate reports (same suburb, request type and day)  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20IS%20NOT%20NULL
&groupByFieldsForStatistics=Suburb%2C%20RequestType%2C%20CAST(DateLogged%20AS%20DATE)%20AS%20LogDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Reports%22%7D%5D
&having=COUNT(ObjectID)%20%3E%201
&orderByFields=Reports%20DESC%2C%20LogDate%20DESC

### Q48 — Distribution of resolution days (buckets of 5)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL%20AND%20DateCompleted%20%3E%3D%20DateLogged
&sqlFormat=native
&groupByFieldsForStatistics=FLOOR(DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%20%2F%205)%20*%205%20AS%20BucketStart%2C%20FLOOR(DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%20%2F%205)%20*%205%20%2B%204%20AS%20BucketEnd
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=BucketStart

### Q49 — Requests logged on weekends (Saturday/Sunday)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DATEPART(weekday%2C%20DateLogged)%20IN%20(1%2C%207)
&sqlFormat=native
&outFields=*
&orderByFields=ObjectID%20DESC

### Q50 — View of unresolved requests  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Status%20%3C%3E%20'Closed'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q51 — Aging buckets for open requests  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Status%20%3C%3E%20'Closed'
&sqlFormat=native
&groupByFieldsForStatistics=CASE%20WHEN%20DATEDIFF(day%2C%20DateLogged%2C%20GETDATE())%20%3C%3D%202%20THEN%20'0-2%20Days'%20WHEN%20DATEDIFF(day%2C%20DateLogged%2C%20GETDATE())%20%3C%3D%207%20THEN%20'3-7%20Days'%20WHEN%20DATEDIFF(day%2C%20DateLogged%2C%20GETDATE())%20%3C%3D%2030%20THEN%20'8-30%20Days'%20ELSE%20'30%2B%20Days'%20END%20AS%20AgeBucket
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22RequestCount%22%7D%2C%7B%22statisticType%22%3A%22min%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DateLogged%2C%20GETDATE())%22%2C%22outStatisticFieldName%22%3A%22MinAgeDays%22%7D%5D
&orderByFields=MinAgeDays

### Q52 — Share of completed requests that took longer than 5 days  [native]
# client-side transform: ratio
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22TotalCompleted%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20DATEDIFF(day%2C%20DateLogged%2C%20DateCompleted)%20%3E%205%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22Over5Days%22%7D%5D

### Q53 — 90th percentile resolution time  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DateCompleted%20IS%20NOT%20NULL
