# Service Request Query Library — ArcGIS REST requests
# Generated by `npm run build:http`. Start the server first: `npm start`.
# Point @layer at a real FeatureServer layer to run the same requests there.

@layer = http://127.0.0.1:3001/arcgis/rest/services/ServiceRequests/FeatureServer/0

### Q0 — Total number of service requests  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&returnCountOnly=true

### Q1 — Count by Category  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC

### Q2 — Count by Category and Status (cross-tab)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Category%2CStatus
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Category%2C%20Status

### Q3 — Requests by logged date (day)  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=CAST(DtLogged%20AS%20DATE)%20AS%20LogDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=LogDate

### Q4 — Requests by logged month and year  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=EXTRACT(YEAR%20FROM%20DtLogged)%20AS%20LogYear%2C%20EXTRACT(MONTH%20FROM%20DtLogged)%20AS%20LogMonth
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=LogYear%2C%20LogMonth

### Q5 — Requests by hour of day  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=EXTRACT(HOUR%20FROM%20DtLogged)%20AS%20LogHour
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=LogHour

### Q6 — Weekly trend (ISO week, ISO year)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=DATEPART(iso_week%2C%20DtLogged)%20AS%20ISOWeek%2C%20YEAR(DATEADD(day%2C%2026%20-%20DATEPART(iso_week%2C%20DtLogged)%2C%20DtLogged))%20AS%20ISOYear
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=ISOYear%2C%20ISOWeek
&sqlFormat=native

### Q7 — Count requests logged in the last 7 days  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtLogged%20%3E%3D%20CURRENT_TIMESTAMP%20-%20INTERVAL%20'7'%20DAY
&returnCountOnly=true

### Q8 — Ten slowest sub-categories (average days to close, min 10 closed)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Status%20%3D%20'Closed'%20AND%20DtCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&groupByFieldsForStatistics=CategorySub
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgDays%22%7D%2C%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Closed%22%7D%5D
&having=COUNT(ObjectID)%20%3E%3D%2010
&orderByFields=AvgDays%20DESC
&resultRecordCount=10

### Q9 — Median resolution time (using PERCENTILE_CONT)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&outStatistics=%5B%7B%22statisticType%22%3A%22percentile_cont%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%22%2C%22outStatisticFieldName%22%3A%22MedianDays%22%2C%22statisticParameters%22%3A%7B%22value%22%3A0.5%7D%7D%5D

### Q10 — Requests completed on the same day they were logged  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL%20AND%20CAST(DtLogged%20AS%20DATE)%20%3D%20CAST(DtCompleted%20AS%20DATE)
&returnCountOnly=true

### Q11 — Open requests in Khayelitsha  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20%3D%20'Khayelitsha'%20AND%20Status%20%3C%3E%20'Closed'
&outFields=*
&orderByFields=ObjectID%20DESC

### Q12 — Top 5 categories with most requests  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Count%20DESC
&resultRecordCount=5

### Q13 — Running total of requests per day (cumulative)  [sql-expression]
# client-side transform: runningTotal
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=CAST(DtLogged%20AS%20DATE)%20AS%20LogDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22DailyCount%22%7D%5D
&orderByFields=LogDate

### Q14 — Month-over-month percentage change in request volume  [sql-expression]
# client-side transform: lag
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=EXTRACT(YEAR%20FROM%20DtLogged)%20AS%20Yr%2C%20EXTRACT(MONTH%20FROM%20DtLogged)%20AS%20Mo
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Cnt%22%7D%5D
&orderByFields=Yr%2C%20Mo

### Q15 — Rank categories by average completion time (fastest first)  [native]
# client-side transform: rank
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgDays%22%7D%5D
&orderByFields=AvgDays

### Q16 — For each Channel, count of distinct categories reported  [standard]
# client-side transform: groupCount
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Channel%2CCategory
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=Channel%2C%20Category

### Q17 — Distribution of resolution days (buckets of 5)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL%20AND%20DtCompleted%20%3E%3D%20DtLogged
&sqlFormat=native
&groupByFieldsForStatistics=FLOOR(DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%20%2F%205)%20*%205%20AS%20BucketStart%2C%20FLOOR(DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%20%2F%205)%20*%205%20%2B%204%20AS%20BucketEnd
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&orderByFields=BucketStart

### Q18 — Share of completed requests that took longer than 5 days  [native]
# client-side transform: ratio
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22TotalCompleted%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%20%3E%205%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22Over5Days%22%7D%5D

### Q19 — 90th percentile resolution time  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL
&sqlFormat=native
&outStatistics=%5B%7B%22statisticType%22%3A%22percentile_cont%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%22%2C%22outStatisticFieldName%22%3A%22P90_Days%22%2C%22statisticParameters%22%3A%7B%22value%22%3A0.9%7D%7D%5D

### Q20 — Thematic grouping of categories (Three Waters, Transport, Waste, …)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&sqlFormat=native
&groupByFieldsForStatistics=CASE%20WHEN%20Category%20IN%20('Water%20Supply'%2C%20'Wastewater%20%26%20Stormwater'%2C%20'Flooding')%20THEN%20'Three%20Waters'%20WHEN%20Category%20IN%20('Roads%20%26%20Footpaths'%2C%20'Streetlights'%2C%20'Abandoned%20Vehicles')%20THEN%20'Transport'%20WHEN%20Category%20IN%20('Rubbish%20%26%20Recycling'%2C%20'Illegal%20Dumping')%20THEN%20'Waste'%20WHEN%20Category%20IN%20('Parks%20%26%20Reserves'%2C%20'Trees')%20THEN%20'Parks%20%26%20Open%20Space'%20WHEN%20Category%20IN%20('Noise'%2C%20'Animals'%2C%20'Graffiti')%20THEN%20'Community%20%26%20Regulatory'%20ELSE%20'Other'%20END%20AS%20Theme
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%2C%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgResolutionDays%22%7D%5D
&orderByFields=Count%20DESC

### Q21 — Channel efficiency (which channel gets closed fastest?)  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&sqlFormat=native
&groupByFieldsForStatistics=Channel
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Total%22%7D%2C%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22DATEDIFF(day%2C%20DtLogged%2C%20DtCompleted)%22%2C%22outStatisticFieldName%22%3A%22AvgCloseDays%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20Status%20%3C%3E%20'Closed'%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22StillOpen%22%7D%5D
&orderByFields=AvgCloseDays

### Q22 — Invalid dates (completed before logged)  [standard]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL%20AND%20DtCompleted%20%3C%20DtLogged
&returnCountOnly=true

### Q23 — Requests with missing fields (Suburb, CategorySub, Description)  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&outStatistics=%5B%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20Suburb%20IS%20NULL%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22MissingSuburb%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20CategorySub%20IS%20NULL%20OR%20CategorySub%20%3D%20''%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22MissingCategorySub%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20Description%20IS%20NULL%20OR%20Description%20%3D%20''%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22MissingDescription%22%7D%5D

### Q24 (logged) — Monthly throughput (logged vs completed side by side)  [sql-expression]
# client-side transform: fullOuterJoin
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=EXTRACT(YEAR%20FROM%20DtLogged)%20AS%20Year%2C%20EXTRACT(MONTH%20FROM%20DtLogged)%20AS%20Month
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Logged%22%7D%5D
&orderByFields=Year%2C%20Month

### Q24 (completed) — Monthly throughput (logged vs completed side by side)  [sql-expression]
# client-side transform: fullOuterJoin
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=DtCompleted%20IS%20NOT%20NULL
&groupByFieldsForStatistics=EXTRACT(YEAR%20FROM%20DtCompleted)%20AS%20Year%2C%20EXTRACT(MONTH%20FROM%20DtCompleted)%20AS%20Month
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Completed%22%7D%5D
&orderByFields=Year%2C%20Month

### Q25 — Pivot: Channel vs Status (conditional aggregation)  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=Channel
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Total%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20Status%20%3D%20'Open'%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22OpenCount%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20Status%20%3D%20'In%20Progress'%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22InProgress%22%7D%2C%7B%22statisticType%22%3A%22sum%22%2C%22onStatisticField%22%3A%22CASE%20WHEN%20Status%20%3D%20'Closed'%20THEN%201%20ELSE%200%20END%22%2C%22outStatisticFieldName%22%3A%22Closed%22%7D%5D
&orderByFields=Channel

### Q26 — Which categories have the most requests stuck open for more than 30 days?  [native]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Status%20%3C%3E%20'Closed'%20AND%20DATEDIFF(day%2C%20DtLogged%2C%20GETDATE())%20%3E%2030
&sqlFormat=native
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22StuckCount%22%7D%5D
&orderByFields=StuckCount%20DESC
&resultRecordCount=5

### Q27 — Which category dominates each suburb?  [standard]
# client-side transform: topPerGroup
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Suburb%20IS%20NOT%20NULL
&groupByFieldsForStatistics=Suburb%2CCategory
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Requests%22%7D%5D
&orderByFields=Suburb%2C%20Requests%20DESC%2C%20Category

### Q28 — Average description length per Category  [sql-expression]
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=Description%20IS%20NOT%20NULL
&groupByFieldsForStatistics=Category
&outStatistics=%5B%7B%22statisticType%22%3A%22avg%22%2C%22onStatisticField%22%3A%22CHAR_LENGTH(Description)%22%2C%22outStatisticFieldName%22%3A%22AvgDescLength%22%7D%2C%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22Count%22%7D%5D
&having=COUNT(ObjectID)%20%3E%2010
&orderByFields=AvgDescLength%20DESC

### Q29 — Moving 7-day average of new requests (to smooth daily noise)  [sql-expression]
# client-side transform: movingAverage -> sort
POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=CAST(DtLogged%20AS%20DATE)%20AS%20LogDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22DailyTotal%22%7D%5D
&orderByFields=LogDate
