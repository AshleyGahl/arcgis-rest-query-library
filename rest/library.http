POST {{layer}}/query
Content-Type: application/x-www-form-urlencoded

f=pjson
&where=1%3D1
&groupByFieldsForStatistics=CAST(DateLogged%20AS%20DATE)%20AS%20LogDate
&outStatistics=%5B%7B%22statisticType%22%3A%22count%22%2C%22onStatisticField%22%3A%22ObjectID%22%2C%22outStatisticFieldName%22%3A%22DailyTotal%22%7D%5D
